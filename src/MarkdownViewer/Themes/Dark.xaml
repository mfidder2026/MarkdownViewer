<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="WindowColor">#0D1117</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <Color x:Key="SurfaceColor">#161B22</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <Color x:Key="TextPrimaryColor">#E6EDF3</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <Color x:Key="TextMutedColor">#8B949E</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="BorderColor">#30363D</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <Color x:Key="RuleColor">#30363D</Color>
    <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />

    <Color x:Key="CodeBackgroundColor">#161B22</Color>
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{StaticResource CodeBackgroundColor}" />
    <Color x:Key="CodeBorderColor">#30363D</Color>
    <SolidColorBrush x:Key="CodeBorderBrush" Color="{StaticResource CodeBorderColor}" />

    <Color x:Key="AccentColor">#58A6FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <Color x:Key="EditorBackgroundColor">#0D1117</Color>
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
    <Color x:Key="EditorCaretColor">#E6EDF3</Color>
    <SolidColorBrush x:Key="EditorCaretBrush" Color="{StaticResource EditorCaretColor}" />

    <Color x:Key="LintErrorColor">#FF7B72</Color>
    <SolidColorBrush x:Key="LintErrorBrush" Color="{StaticResource LintErrorColor}" />
    <Color x:Key="LintWarnColor">#D29922</Color>
    <SolidColorBrush x:Key="LintWarnBrush" Color="{StaticResource LintWarnColor}" />
    <Color x:Key="LintInfoColor">#58A6FF</Color>
    <SolidColorBrush x:Key="LintInfoBrush" Color="{StaticResource LintInfoColor}" />

    <Color x:Key="GitModifiedColor">#D29922</Color>
    <SolidColorBrush x:Key="GitModifiedBrush" Color="{StaticResource GitModifiedColor}" />
    <Color x:Key="GitAddedColor">#3FB950</Color>
    <SolidColorBrush x:Key="GitAddedBrush" Color="{StaticResource GitAddedColor}" />
    <Color x:Key="GitDeletedColor">#FF7B72</Color>
    <SolidColorBrush x:Key="GitDeletedBrush" Color="{StaticResource GitDeletedColor}" />

    <Color x:Key="TabHoverColor">#21FFFFFF</Color>
    <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource TabHoverColor}" />

    <sys:String x:Key="ThemeName">Dark</sys:String>
</ResourceDictionary>