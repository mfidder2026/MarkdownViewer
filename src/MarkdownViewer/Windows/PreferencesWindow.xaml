<Window x:Class="MarkdownViewer.Windows.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="460" Height="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Preferences"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Theme:" VerticalAlignment="Center" Width="120"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="ThemeBox" Width="200" SelectionChanged="OnThemeChanged"/>
                </StackPanel>

                <TextBlock Text="Editor" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="WordWrapBox" Content="Word wrap" Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="LineNumbersBox" Content="Show line numbers" Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="SpellCheckBox" Content="Spell checking" Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="EditorPaneBox" Content="Show editor pane" Margin="0,0,0,16"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="Autosave" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="AutosaveBox" Content="Enable autosave" Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Interval (seconds):" VerticalAlignment="Center" Width="140"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="AutosaveIntervalBox" Width="80"/>
                </StackPanel>

                <TextBlock Text="Panels" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="FileBrowserBox" Content="Show file browser sidebar" Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="LintPanelBox" Content="Show Markdown lint panel" Margin="0,0,0,16"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="Privacy and Updates" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="UpdateCheckBox" Content="Check for updates on startup (opt-in)"
                          Margin="0,0,0,6"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <CheckBox x:Name="TelemetryBox"
                          Content="Enable local-only telemetry (stored on this PC, never sent)"
                          Margin="0,0,0,16"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="Typography" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Font family:" VerticalAlignment="Center" Width="120"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="FontFamilyBox" Width="220"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Font size:" VerticalAlignment="Center" Width="120"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="FontSizeBox" Width="80"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="80" Padding="12,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="80" Padding="12,4" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>