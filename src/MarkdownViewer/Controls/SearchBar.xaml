<UserControl x:Class="MarkdownViewer.Controls.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}"
             Visibility="Collapsed">
    <DockPanel LastChildFill="True" Margin="8,4">
        <Button DockPanel.Dock="Right" x:Name="CloseBtn" Content="✕"
                Width="24" Height="24" Margin="6,0,0,0"
                Background="Transparent" BorderThickness="0"
                Click="OnClose"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock DockPanel.Dock="Left" x:Name="MatchCount"
                   VerticalAlignment="Center" Margin="6,0,12,0"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <Button DockPanel.Dock="Left" x:Name="PrevBtn" Content="↑"
                Width="24" Height="24" Margin="4,0,0,0"
                Click="OnPrev"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button DockPanel.Dock="Left" x:Name="NextBtn" Content="↓"
                Width="24" Height="24" Margin="2,0,8,0"
                Click="OnNext"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBox x:Name="QueryBox" VerticalContentAlignment="Center"
                 Padding="6,2"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Background="{DynamicResource EditorBackgroundBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 KeyDown="OnQueryKeyDown"/>
    </DockPanel>
</UserControl>