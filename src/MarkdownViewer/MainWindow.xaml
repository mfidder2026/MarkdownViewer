<Window x:Class="MarkdownViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkdownViewer"
        xmlns:ctrl="clr-namespace:MarkdownViewer.Controls"
        Title="Markdown Viewer"
        Height="760" Width="1200"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Focusable="True"
        Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static local:MainWindow.OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{x:Static local:MainWindow.CloseTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="P" Command="{x:Static local:MainWindow.PrintCommand}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static local:MainWindow.FindCommand}"/>
        <KeyBinding Modifiers="Control" Key="N" Command="{x:Static local:MainWindow.NewTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="B" Command="{x:Static local:MainWindow.ToggleBrowserCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="4">
            <MenuItem Header="_File">
                <MenuItem Header="_New Tab" InputGestureText="Ctrl+N"
                          Command="{x:Static local:MainWindow.NewTabCommand}"/>
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O"
                          Command="{x:Static local:MainWindow.OpenCommand}"/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S"
                          Command="{x:Static local:MainWindow.SaveCommand}"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S"
                          Command="{x:Static local:MainWindow.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="_Export">
                    <MenuItem Header="HTML..." Command="{x:Static local:MainWindow.ExportHtmlCommand}"/>
                    <MenuItem Header="PDF..." Command="{x:Static local:MainWindow.ExportPdfCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Print..." InputGestureText="Ctrl+P"
                          Command="{x:Static local:MainWindow.PrintCommand}"/>
                <Separator/>
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W"
                          Command="{x:Static local:MainWindow.CloseTabCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F"
                          Command="{x:Static local:MainWindow.FindCommand}"/>
                <Separator/>
                <MenuItem Header="Toggle _Favourite"
                          Command="{x:Static local:MainWindow.ToggleFavouriteCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle File _Browser" InputGestureText="Ctrl+B"
                          Command="{x:Static local:MainWindow.ToggleBrowserCommand}"/>
                <MenuItem Header="Toggle Editor Pane"
                          Command="{x:Static local:MainWindow.ToggleEditorCommand}"/>
                <MenuItem Header="Toggle Lint Panel"
                          Command="{x:Static local:MainWindow.ToggleLintCommand}"/>
                <Separator/>
                <MenuItem Header="_Light Theme"
                          Command="{x:Static local:MainWindow.LightThemeCommand}"/>
                <MenuItem Header="_Dark Theme"
                          Command="{x:Static local:MainWindow.DarkThemeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Recent" x:Name="RecentMenu"/>
            <MenuItem Header="_Favourites" x:Name="FavouritesMenu"/>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Preferences..." Command="{x:Static local:MainWindow.PreferencesCommand}"/>
                <MenuItem Header="Check for _Updates..." Command="{x:Static local:MainWindow.CheckUpdateCommand}"/>
                <MenuItem Header="Manage _Plugins..." Command="{x:Static local:MainWindow.ManagePluginsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{x:Static local:MainWindow.AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Search bar (toggled with Ctrl+F) -->
        <ctrl:SearchBar x:Name="SearchBarCtrl" DockPanel.Dock="Top"/>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="LintSummary" Foreground="{DynamicResource TextMutedBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Left sidebar: file browser -->
        <Grid x:Name="BrowserHost" DockPanel.Dock="Left" Width="240"
              Background="{DynamicResource SurfaceBrush}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Files" FontWeight="SemiBold"
                       Margin="10,8,0,6"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TreeView Grid.Row="1" x:Name="FileTree"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      MouseDoubleClick="OnFileTreeDoubleClick"/>
        </Grid>

        <!-- Right sidebar: lint panel -->
        <Grid x:Name="LintHost" DockPanel.Dock="Right" Width="260"
              Background="{DynamicResource SurfaceBrush}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Lint" FontWeight="SemiBold"
                       Margin="10,8,0,6"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <ListBox Grid.Row="1" x:Name="LintList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     MouseDoubleClick="OnLintDoubleClick"/>
        </Grid>

        <!-- Center: tabs + editor/preview -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="Tabs" TabStripPlacement="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        SelectionChanged="OnTabSelectionChanged"/>
            <!-- Tab content host is rendered manually in code: editor + preview split -->

            <Grid Grid.Row="1" x:Name="ContentHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="5"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Editor -->
                <TextBox Grid.Column="0" x:Name="Editor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="12,8"
                         BorderThickness="0,1,0,0"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Background="{DynamicResource EditorBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource EditorCaretBrush}"
                         TextChanged="OnEditorTextChanged"
                         SpellCheck.IsEnabled="True"
                         Visibility="Collapsed"/>

                <GridSplitter Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"
                              Visibility="Collapsed"
                              x:Name="Splitter"/>

                <!-- Preview -->
                <FlowDocumentScrollViewer Grid.Column="2" x:Name="DocViewer"
                                          IsToolBarVisible="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="48,24,48,32"
                                          BorderThickness="1,1,0,0"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontFamily="Segoe UI"
                                          FontSize="15"/>

                <!-- Empty state overlay -->
                <Grid Grid.ColumnSpan="3" x:Name="EmptyState" Background="{DynamicResource WindowBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Open a Markdown file to view it."
                                   FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Ctrl+O to open · Ctrl+N for a new tab"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>